# Copy to .env and fill in. .env is never committed.
# Every route works without its credential; it is just skipped.

# ── Routes ────────────────────────────────────────────────────────────────────
# api-scrapingbee. SCRAPINGBEE_PREMIUM=0 uses the 1-credit classic tier.
SCRAPINGBEE_KEY=
SCRAPINGBEE_PREMIUM=1
# api-brightdata: a proxy zone URL, or the Scraping Browser CDP endpoint.
# Set at most one: a Scraping Browser credential used as a proxy is refused.
BRIGHTDATA_PROXY_URL=
BRIGHTDATA_WS=
# collector: API token and collector id.
API_TOKEN_BRINGDATA=
BRIGHTDATA_COLLECTOR=

# ── Crawl (defaults shown) ────────────────────────────────────────────────────
# ENCAR_DB=var/encar.db
ENCAR_WORKERS=8
ENCAR_MODEL_COOLDOWN=60
ENCAR_DETAIL_MAX_AGE_DAYS=90
SOLD_MISSING_STREAK=2
SOLD_THRESHOLD_OK=0.99

# ── Partners stock (main.py sync-sold, every 10 min) ──────────────────────────
# GET <url>/active-car-id, POST <url>/update-car-id
PARTNERS_API_URL=https://qa-mng.702prime.com/api/partners-stock
# PARTNERS_LOG_FILE=logs/sync-sold.log

# ── Dashboard ─────────────────────────────────────────────────────────────────
UI_PORT=5050
LOG_FILE=logs/encar.log

# ── Online (serve.sh) ─────────────────────────────────────────────────────────
# Login for the dashboard. serve.sh will not open a tunnel without a password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Optional: a named Cloudflare tunnel for a fixed hostname. Without it, a
# random *.trycloudflare.com URL is used (logs/tunnel-url.txt).
CLOUDFLARE_TUNNEL_TOKEN=
