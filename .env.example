# Copy to .env and fill in. .env is never committed.

# ── Database (stock_pipeline) ─────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── Bright Data ───────────────────────────────────────────────────────────────
# API token for the DCA collector (brightdata_collector).
API_TOKEN_BRINGDATA=
BRIGHTDATA_COLLECTOR=
# Proxy zone URL, or the Scraping Browser CDP endpoint (listing_export).
# Set at most one: a Scraping Browser credential used as a plain proxy is
# refused with 403.
BRIGHTDATA_PROXY_URL=
BRIGHTDATA_WS=

# ── Crawl pacing (stock_pipeline/config.py; defaults in brackets) ─────────────
SYNC_PAGE_SIZE=200
SYNC_LIST_WORKERS=4
SYNC_DETAIL_WORKERS=4
SYNC_MODEL_COOLDOWN=60
SOLD_MISSING_STREAK=2

# ── Dashboard ─────────────────────────────────────────────────────────────────
UI_PORT=5050
LOG_FILE=logs/encar.log
