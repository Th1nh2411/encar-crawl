# Secrets and local config
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Run artefacts: output/<tool>/<name>_<timestamp>.{json,csv} and the run log
output/
logs/
*.log

# State the next run reads: the plate cache and the throttle memory. Separate
# from output/ because these are not results — deleting the cache costs
# thousands of requests to rebuild it.
var/

# Ad-hoc exports that predate output/
/out.json
/out.csv

# OS and editor
.DS_Store
.idea/
.vscode/
